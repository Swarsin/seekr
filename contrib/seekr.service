[Unit]
Description=seekr local semantic search service
Documentation=https://github.com/Swarsin/seekr
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
# pipx installs the CLI here.  Replace this path if seekr lives elsewhere.
ExecStart=%h/.local/bin/seekr service start
Restart=on-failure
RestartSec=2
# SIGTERM makes the service stop the watcher, close the index and remove its
# discovery file before exiting.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
