<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.seekr.service</string>
  <!-- Replace /Users/YOU/.local/bin/seekr with the output of `which seekr`.
       launchd does not expand ~ or $HOME here. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/seekr</string>
    <string>service</string>
    <string>start</string>
    <string>--port</string>
    <string>8000</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/seekr-service.log</string>
</dict>
</plist>
